{
  "name": "lit-canon-fetch",
  "version": "1.0.0",
  "description": "Small browser fetch runtime for clients generated by lit-canon-api: JSON, query strings, problem details and typed errors.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathisarends/lit-canon-api.git",
    "directory": "packages/fetch"
  },
  "bugs": {
    "url": "https://github.com/mathisarends/lit-canon-api/issues"
  },
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test test/*.test.ts",
    "typecheck": "pnpm run build && tsc -p tsconfig.test.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.3"
  },
  "keywords": [
    "fetch",
    "api-client",
    "problem-details",
    "rfc9457",
    "lit",
    "lit-canon"
  ]
}
