{
  "name": "lit-canon-composition",
  "version": "0.1.0",
  "description": "A thin, opinionated layer over Lit: register pages, bundle them into features, compose features into an app.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathisarends/lit-canon.git",
    "directory": "packages/composition"
  },
  "homepage": "https://github.com/mathisarends/lit-canon/tree/main/packages/composition#readme",
  "bugs": {
    "url": "https://github.com/mathisarends/lit-canon/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "vite examples/basic",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@tanstack/lit-query": "^0.2.25",
    "@lit-labs/router": "^0.1.4",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/lit-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "lit": "^3.3.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
