{
  "name": "lit-canon-composition",
  "version": "0.1.0",
  "description": "A thin, opinionated layer over Lit: register pages, bundle them into features, compose features into an app.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "example": "vite examples/basic"
  },
  "peerDependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit/context": "^1.1.6",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@lit-labs/router": "^0.1.4",
    "@lit/context": "^1.1.6",
    "@lit/task": "^1.0.3",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "lit": "^3.3.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
